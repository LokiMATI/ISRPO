<Window x:Class="LabWindow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LabWindow"
        mc:Ignorable="d"
        Title="MainWindow" Height="800" Width="400">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <Label Content="Регистрация" FontSize="30"/>
        
        <Label Content="Логин"/>
        <TextBox Name="LoginTextBox"/>

        <Label Content="Пароль"/>
        <TextBox Name="PasswordTextBox"/>

        <Label Content="Подтверждение пароля"/>
        <TextBox Name="ConfirmPasswordTextBox"/>

        <Label Content="Email"/>
        <TextBox Name="EmailTextBox"/>

        <Button Content="Зарегестрироваться" Name="RegistrationButton" Click="RegistrationButton_Click"/>
    </StackPanel>
</Window>
