<Window x:Class="UsersApp.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UsersApp"
        mc:Ignorable="d"
        Title="Окно регистрации" Height="500" Width="400">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <Label Content="Окно регистрации" FontSize="20"/>
        <Label Content="Имя пользователя"/>
        <TextBox Name="UsernameTextBox"/>
        <Label Content="Пароль"/>
        <TextBox Name="PasswordTextBox"/>
        <Button x:Name="RegistrationButton" Content="Зарегистрироваться" Click="RegistrationButton_Click"/>
    </StackPanel>
</Window>
